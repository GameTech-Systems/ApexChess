{
  "name": "apexchess",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @apexchess/web dev",
    "dev:server": "pnpm --filter @apexchess/web build && pnpm dlx wrangler@4 dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "validate:rules": "node scripts/validate-rules.mjs",
    "sim": "pnpm --filter @apexchess/sim sim"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
