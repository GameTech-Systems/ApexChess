{
  "name": "apexchess",
  "compatibility_date": "2026-10-01",
  // Online play (S18): /api goes to the Worker; everything else is the static app.
  "main": "./apps/server/src/worker.ts",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
    ],
  },
  // Anonymous game archive (S19a). database_id is a placeholder until the owner runs
  // `wrangler d1 create apexchess-archive` (docs/decisions/0004-hosting.md); local dev ignores it.
  "d1_databases": [
    {
      "binding": "ARCHIVE",
      "database_name": "apexchess-archive",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./apps/server/migrations",
    },
  ],
  // Daily public setup statistics (S19b): rebuilt shortly after midnight UTC.
  "triggers": { "crons": ["7 0 * * *"] },
  // Rate limit on /api: 60 requests per address per minute (provisional).
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }],
}
