{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Time controls for online play (D19)",
  "description": "The time controls a room or quick match may use. The default must be one of the control ids (checked by @apexchess/online).",
  "type": "object",
  "additionalProperties": false,
  "required": ["default", "status", "decision", "source", "controls"],
  "properties": {
    "default": { "type": "string", "minLength": 1 },
    "status": { "enum": ["decided", "provisional"] },
    "decision": { "type": "string", "pattern": "^D[0-9]+$" },
    "source": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9+]{1,16}$" },
          "kind": { "enum": ["untimed", "fischer", "perMove", "abandonment"] },
          "label": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "id": true,
              "label": true,
              "kind": { "const": "untimed" }
            }
          },
          {
            "additionalProperties": false,
            "required": ["initialSeconds", "incrementSeconds"],
            "properties": {
              "id": true,
              "label": true,
              "kind": { "const": "fischer" },
              "initialSeconds": { "type": "integer", "minimum": 1 },
              "incrementSeconds": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "additionalProperties": false,
            "required": ["seconds"],
            "properties": {
              "id": true,
              "label": true,
              "kind": { "const": "perMove" },
              "seconds": { "type": "integer", "minimum": 1 }
            }
          },
          {
            "additionalProperties": false,
            "required": ["graceSeconds"],
            "properties": {
              "id": true,
              "label": true,
              "kind": { "const": "abandonment" },
              "graceSeconds": { "type": "integer", "minimum": 1 }
            }
          }
        ]
      }
    }
  }
}
