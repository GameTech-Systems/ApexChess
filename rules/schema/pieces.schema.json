{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pieces",
  "description": "Movement data for each piece. Steps are [file, rank] written for light; the board's mirror maps them for dark.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "name", "pieces", "source"],
  "definitions": {
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "mode"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer" }
          }
        },
        "range": {
          "type": "integer",
          "minimum": 1,
          "description": "Most squares per step direction; omitted means slide to the board edge. Blocked by the first occupied square."
        },
        "mode": {
          "enum": ["move", "capture", "both"],
          "description": "move: empty squares only; capture: enemy pieces only; both: either."
        },
        "onFarEdge": {
          "type": "boolean",
          "description": "Applies only when the piece is (true) or is not (false) on one of its side's far edges; omitted means always."
        },
        "firstMove": {
          "type": "boolean",
          "description": "true: applies only while the piece has not moved."
        },
        "when": {
          "type": "object",
          "description": "Applies only when each listed ruleset parameter has this value.",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "official", "retired"] },
    "name": { "type": "string", "minLength": 1 },
    "pieces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moves"],
        "properties": {
          "royal": {
            "type": "boolean",
            "description": "true: its side may never leave it attacked, and checkmating it wins."
          },
          "resetsMoveRule": {
            "type": "boolean",
            "description": "true: its moves reset the move-rule count, as captures do."
          },
          "moves": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/movement" }
          },
          "promotesTo": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z]+$" },
            "description": "Pieces this piece may become on its side's promotion squares."
          }
        }
      }
    },
    "source": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
